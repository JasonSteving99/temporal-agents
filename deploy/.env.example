# Copy to `.env` (gitignored) and fill in. Loaded by every service in docker-compose.yml.

# --- Temporal connection --------------------------------------------------------------------------
# The mounted temporal.toml (see temporal.cloud.toml.example) holds address / namespace / api_key.
# These two point the harness's ClientConfig.load_client_connect_config() at it.
TEMPORAL_CONFIG_FILE=/run/temporal/temporal.toml
TEMPORAL_PROFILE=default

# --- Gemini (worker) ------------------------------------------------------------------------------
# Required: the agent calls the Gemini Interactions API.
GEMINI_API_KEY=

# --- E2B (worker + build-sandbox) -----------------------------------------------------------------
# Required: the agent's tools run in an E2B sandbox, and build-sandbox builds its template.
# The backend moved from Daytona to E2B because Daytona blocks sandbox egress to everything outside a
# fixed "essential services" allowlist on tiers 1-2 and refuses to let it be overridden, so a sandbox
# could never reach Tailscale's control plane. See examples/sandbox_tools/coding_agent/README.md.
E2B_API_KEY=

# --- Tailscale (worker) ---------------------------------------------------------------------------
# OPTIONAL. Set TAILSCALE_API_KEY to put every sandbox the agent creates on your tailnet; leave it
# blank and sandboxes simply never join one (nothing else changes).
#
# How it works: the worker's backend provider (examples/sandbox_tools/coding_agent/tailscale.py) calls
# the Tailscale API once per sandbox to mint an EPHEMERAL, tagged auth key, and passes it into the new
# sandbox as TAILSCALE_AUTHKEY, where the template's tailscale_up.sh redeems it (fired as the E2B
# backend's post_create_cmd — the only hook that can see a per-sandbox env var). Ephemeral so dead
# sandboxes remove themselves from your tailnet instead of piling up as stale machines.
#
# The key is REUSABLE, and that is deliberate: the sandbox is paused between chat turns, and Tailscale
# reaps an ephemeral node that has been silent long enough, so a session picked up after a long idle
# comes back with no place on the tailnet. An in-sandbox watchdog notices and redeems the key AGAIN —
# which a single-use key cannot do, leaving the tailnet (and the AI gateway below) dead for the rest of
# the session. See TAILSCALE_KEY_REUSABLE to opt out.
#
# The API token, from https://login.tailscale.com/admin/settings/keys ("Auth keys" -> "API access
# tokens"). This is a LONG-LIVED credential that can mint node keys — it stays on this host and is
# never given to a sandbox. Tailscale caps API tokens at 90 days, so this needs periodic rotation;
# an OAuth client with the `auth_keys` scope avoids that if you'd rather not rotate.
TAILSCALE_API_KEY=

# The ACL tag stamped on every minted key — the sandbox's identity on your tailnet, and the ONLY
# thing your ACLs should grant against. `tag:` is added if you omit it.
#
# BEFORE turning this on, two edits in your tailnet policy file, or key creation fails:
#   1. tagOwners — the identity behind TAILSCALE_API_KEY must own the tag, e.g.
#        "tagOwners": { "tag:agent-artifact": ["autogroup:admin"] }
#   2. acls — grant that tag the LEAST access that makes this useful. Agent-built code runs as this
#      node, so anything the tag can reach, a prompt-injected agent can reach.
TAILSCALE_TAG=tag:agent-artifact

# Which tailnet to mint in. "-" (the default) means the token's own tailnet — right unless your token
# administers several.
TAILSCALE_TAILNET=-

# How long the key stays valid. This bounds the theft window for a key at rest — and, because the key
# is redeemed again whenever the sandbox has to rejoin, it also bounds how long a chat can idle and
# still get its tailnet back. One day covers "I'll finish this tomorrow" without becoming a standing
# credential; shorten it if you'd rather lose the tailnet than keep the key alive.
TAILSCALE_KEY_EXPIRY_SECONDS=86400

# Set to 0 to mint SINGLE-USE keys instead. Safer at rest (a key read out of a sandbox can join
# nothing), at the cost of the rejoin above: sandboxes idle long enough for Tailscale to reap their
# node then stay off the tailnet for the rest of the session.
# TAILSCALE_KEY_REUSABLE=1

# --- AI gateway for agent-built apps --------------------------------------------------------------
# OPTIONAL, and only useful with the tailnet above. A pre-authenticated Gemini endpoint the SANDBOX
# can reach — here a Tailscale Aperture node on the tailnet, so calls are authorized by the sandbox's
# tailnet identity and carry no credential at all. Set this and the agent is told it can build AI
# features by pointing `google-genai` at it (no API key ever enters the sandbox or the code); leave it
# blank and the agent is never told the gateway exists.
#
# It is reachable from INSIDE the sandbox only, so agent-built sites must call it server-side — the
# instruction says so explicitly, since a browser-side fetch would fail for the user.
AI_GATEWAY_URL=http://llm
# Models the gateway serves, best first. The agent picks per task.
AI_GATEWAY_MODELS=gemini-3.6-flash, gemini-3.5-flash-lite

# --- Live-preview proxy ---------------------------------------------------------------------------
# Base domain the preview proxy routes sandbox subdomains under. A running site is reached at
# https://<sandboxId>-<port>.<this>/ . Used by BOTH the worker (to tell the user the URL) and the
# preview-proxy (to parse the sandbox out of the Host header). Requires a wildcard DNS record
# *.<this> pointing at this host and a reverse proxy terminating wildcard TLS (see deploy/README.md).
# Leave blank to disable previews entirely (the agent then won't offer them).
PREVIEW_BASE_DOMAIN=

# Pause a sandbox after this many minutes with NOBODY using it. The proxy does this itself: E2B has
# no server-side idle stop, and its `timeout` KILLS the sandbox rather than pausing it, which would
# destroy the chat session and not just the preview. pause() preserves memory as well as disk, so the
# agent's server is still running when the next request resumes it.
#
# "Nobody" includes the AGENT, whose tool calls never reach this proxy — it reads them off the
# sandbox's E2B lifetime instead, which every tool call refreshes. That heartbeat ticks once per tool
# call, so keep this comfortably ABOVE the longest single tool activity (the agent's `bash` allows 3
# minutes) or a slow build looks exactly like an idle box and gets paused out from under the turn.
PREVIEW_AUTO_STOP_MINUTES=10
# Backstop only: the lifetime the proxy hands a sandbox it resumes, in case the proxy dies before its
# own idle timer fires. Must comfortably exceed the idle window above (default: 4x it, min 30 min).
# PREVIEW_SANDBOX_TIMEOUT_SECONDS=1800

# --- Preview auth (Firebase Authentication) -------------------------------------------------------
# Gates every preview behind a Google sign-in, so agent-built sites aren't world-readable by anyone
# who guesses a sandbox subdomain. Leave FIREBASE_API_KEY blank to disable the gate (previews open to
# all). From Firebase Console -> Project settings -> Your apps -> SDK setup and configuration:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# ADMINS — comma-separated emails. These accounts get the admin panel at
# https://<PREVIEW_BASE_DOMAIN>/__auth/admin (linked from the gallery), where you add/remove
# everyone else live.
# Deliberately env-only and never writable over HTTP: this is the one list nothing served by the
# proxy can change, so a guest can never promote themselves. Changing it needs a restart.
# Everyone else is stored separately, in a JSON file on the preview-auth volume
# (PREVIEW_ALLOWLIST_PATH), each with a role: "preview" (previews only) or "agent" (previews plus
# the agent). Only an admin can assign the agent role, and only from the panel.
# Required: Google sign-in accepts ANY Google account, so with no admins and no guests, nobody
# gets in (a deliberate hard deny, not "allow all").
PREVIEW_ADMIN_EMAILS=

# Signs the session cookie. Generate once with `openssl rand -hex 32`. If blank, a random key is
# picked per process and everyone is signed out on every proxy restart.
PREVIEW_SESSION_SECRET=
# How long a sign-in lasts (default 168 = 7 days).
PREVIEW_SESSION_HOURS=168

# In Firebase Console -> Authentication: enable the Google provider, and under Settings -> Authorized
# domains add exactly ONE host: <PREVIEW_BASE_DOMAIN> (that's the only origin sign-in runs on; the
# session cookie is scoped to <PREVIEW_BASE_DOMAIN> so it covers every sandbox subdomain).
#
# That host needs its OWN DNS record — a wildcard *.<PREVIEW_BASE_DOMAIN> does not match
# <PREVIEW_BASE_DOMAIN> itself — plus its own Caddy block (see deploy/README.md). If you can't add
# one, point these pages at a name the wildcard already covers and add THAT to Firebase instead:
# PREVIEW_AUTH_HOST=login.<PREVIEW_BASE_DOMAIN>

# --- The agent app, reverse-proxied ADMINS ONLY ----------------------------------------------------
# Set this to publish the chat UI at https://agent.<PREVIEW_BASE_DOMAIN>/ through the preview proxy,
# behind the SAME Firebase sign-in — but only for admins and members an admin has given the "agent"
# role, because every message spends model tokens and sandbox compute. Empty (the default) leaves the agent
# reachable only however you reach it today, e.g. Tailscale or an SSH tunnel to port 3010.
# The value is where the FastAPI server listens on the compose network:
# PREVIEW_AGENT_UPSTREAM=http://server:8000
PREVIEW_AGENT_UPSTREAM=
# The hostname to serve it on. Defaults to agent.<PREVIEW_BASE_DOMAIN>, which your existing wildcard
# DNS record and wildcard Caddy block already cover — no new DNS, no new Caddy block, no new Firebase
# authorized domain.
PREVIEW_AGENT_HOST=

# --- Preview gallery ------------------------------------------------------------------------------
# https://<PREVIEW_BASE_DOMAIN>/ lists every preview site the proxy has ever served, as
# screenshots. Registration is automatic — nothing to configure. Screenshots are captured only when
# a sandbox is ALREADY awake (right after the proxy wakes it for a real visitor), so the gallery
# never costs you a wake; that's also why tiles are images rather than live iframes.
# Set to 0 to skip capture entirely and show placeholder tiles instead (saves ~150MB of Chromium in
# the image if you also drop the `playwright install` layer from the Dockerfile).
PREVIEW_SCREENSHOTS=1
# Cap on remembered apps; the least-recently-visited is dropped past this.
PREVIEW_MAX_APPS=300

# --- Large-payload offload ------------------------------------------------------------------------
# "local" writes to the Docker-managed `large-payloads` volume (fine for one host). Use "s3" for
# multi-host — then set LARGE_PAYLOAD_S3_BUCKET and provide AWS creds via the standard chain.
LARGE_PAYLOAD_DRIVER=local
LARGE_PAYLOAD_DIR=/data/large-payloads
# The payload-gc sidecar deletes offloaded files older than this, this often (the driver never GCs
# on its own). Defaults are fine unless you keep chat sessions open for many days.
PAYLOAD_GC_MAX_AGE_DAYS=7
PAYLOAD_GC_INTERVAL_SECONDS=86400
