# Shared environment for the bundled examples. Copy this file to `.env.local` (gitignored) at the
# repo root and edit it:
#
#     cp .env.example .env.local
#
# The root justfile auto-loads `.env.local` for every recipe (and the per-example justfiles read
# this same root file via dotenv-path), so these become environment variables the worker /
# session-manager / server all see. Nothing is passed on the command line.

# --- Temporal connection ----------------------------------------------------------------------
# Path to a temporal.toml-format config (https://docs.temporal.io/cli#environment-configuration)
# holding your connection profiles. Resolved relative to the repo root (the recipes run there).
#
# The committed temporal.local.toml ships a `default` profile pointing at a local dev server
# (`just temporal`). To run against your own server or Temporal Cloud, point this at a private
# file instead — create temporal.toml (gitignored), add a profile with your
# address/namespace/api_key, and set TEMPORAL_CONFIG_FILE=temporal.toml below.
TEMPORAL_CONFIG_FILE=temporal.local.toml

# Which profile in that file to use.
TEMPORAL_PROFILE=default

# --- Gemini -----------------------------------------------------------------------------------
# Required by the Gemini-backed example agents (Monty chat, the wiki keeper) — they call the
# Gemini API. Leave blank if you're only running the OpenAI example.
GEMINI_API_KEY=

# --- OpenAI -----------------------------------------------------------------------------------
# Required by the OpenAI Agents example (examples/openai_hello) — its model activities call the
# OpenAI API. Leave blank if you're only running the Gemini-backed examples.
OPENAI_API_KEY=

# --- E2B ----------------------------------------------------------------------------------------
# Required by the sandboxed coding agent: its tools run in an E2B cloud sandbox, and `just
# build-sandbox` builds that sandbox's template. From https://e2b.dev/dashboard -> API keys.
E2B_API_KEY=

# --- Daytona ------------------------------------------------------------------------------------
# No longer used by the sandboxed coding agent (it moved to E2B — see
# examples/sandbox_tools/coding_agent/README.md). Still required if examples/sandboxed_tool_demo's
# SANDBOX is switched from the default Subprocess() backend to Daytona(...). Leave blank otherwise.
DAYTONA_API_KEY=

# --- Tailscale --------------------------------------------------------------------------------
# Optional, and used only by the sandboxed coding agent's worker. Set TAILSCALE_API_KEY to put every
# Daytona sandbox it creates on your tailnet: the worker's backend provider
# (examples/sandbox_tools/coding_agent/tailscale.py) mints a single-use, ephemeral, tagged auth key
# per sandbox and injects it as TAILSCALE_AUTHKEY, which the template's tailscale_up.sh redeems.
# Leave blank and sandboxes join no tailnet. An API access token from
# https://login.tailscale.com/admin/settings/keys — it stays in the worker and never reaches a
# sandbox. See deploy/.env.example for the two tailnet-policy edits (tagOwners + an ACL for the tag)
# this needs before it will work.
TAILSCALE_API_KEY=
# The ACL tag every minted key carries — the sandbox's identity, and what your ACLs grant against.
TAILSCALE_TAG=tag:agent-artifact
# Tailnet to mint in; "-" means the token's own. And how long an unredeemed key stays valid.
TAILSCALE_TAILNET=-
TAILSCALE_KEY_EXPIRY_SECONDS=3600

# --- AI gateway for agent-built apps -----------------------------------------------------
# OPTIONAL, and only useful with the tailnet above. A pre-authenticated Gemini endpoint the SANDBOX
# can reach — here a Tailscale Aperture node on the tailnet, so calls are authorized by the sandbox's
# tailnet identity and carry no credential at all. Set this and the agent is told it can build AI
# features by pointing `google-genai` at it (no API key ever enters the sandbox or the code); leave it
# blank and the agent is never told the gateway exists.
#
# It is reachable from INSIDE the sandbox only, so agent-built sites must call it server-side — the
# instruction says so explicitly, since a browser-side fetch would fail for the user.
AI_GATEWAY_URL=http://llm
# Models the gateway serves, best first. The agent picks per task.
AI_GATEWAY_MODELS=gemini-3.6-flash, gemini-3.5-flash-lite

# --- Large-payload offload --------------------------------------------------------------------
# Some payloads (e.g. Monty sandbox snapshots) can exceed Temporal's ~2 MB limit, so they're
# offloaded to external storage. "local" (filesystem) is fine for single-host local dev; use "s3"
# for multi-host deploys (then set LARGE_PAYLOAD_S3_BUCKET — see
# temporal_agent_harness/utils/large_payload.py).
LARGE_PAYLOAD_DRIVER=local
